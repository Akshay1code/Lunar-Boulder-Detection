# Lunar-CV Environment Variables Template
# Copy this file to .env and fill in your values if needed:
# cp .env.example .env

# Roboflow API configuration (optional, if downloading datasets directly via Roboflow API)
ROBOFLOW_API_KEY=

# Weights & Biases configuration (optional, for experiment tracking)
WANDB_API_KEY=
WANDB_PROJECT=lunar-cv

# Hardware / Device configuration (optional)
# CUDA_VISIBLE_DEVICES=0
