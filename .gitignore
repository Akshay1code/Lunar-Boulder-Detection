# ==========================================
# Lunar-CV Git Ignore Configuration
# ==========================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Secrets, Credentials & Local Config ---
.env
.env.local
.env.*.local
*.key
*.pem
*.cert
*.secret
secrets.*

# --- Large Training Runs & Logs (650+ MB) ---
runs/
runs/**
*.log

# --- Large Per-Epoch Report Plots (180+ MB) ---
reports/ultralytics_results/

# --- Heavy Weight Checkpoints ---
# Ignore all checkpoint weights from runs
runs/**/weights/
# Pretrained base weights in weights/ are tracked (or uncomment below to exclude):
# weights/*.pt
!weights/*.pt
!weights/.gitkeep
!weights/README.md

# --- Raw Dataset Images (~100 MB / 3,800+ files) ---
# Raw images should be downloaded via Roboflow (see README.md)
train/images/*
!train/images/.gitkeep
valid/images/*
!valid/images/.gitkeep
test/images/*
!test/images/.gitkeep

# Auxiliary raw datasets & generated boulder splits
boulders/
boulder_raw/

# --- Temporary & Scratch Files ---
scratch/
tmp/
temp/

# --- IDE & Editor Settings ---
.vscode/*
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- OS-generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
